# Serper API key (https://serper.dev) for live Google results.
# Leave empty to use only the bundled local search index (works offline).
SERPER_API_KEY=

# auto   = live results via Serper, falling back to the local index if Serper
#          is unreachable or out of credits (default)
# serper = Serper only (errors are shown to the user)
# local  = local index only, never uses the network
SEARCH_PROVIDER=auto

# Port for `python main.py` (the uvicorn command line uses --port instead).
PORT=8000

# Comma-separated origins allowed to call the API in dev.
CORS_ORIGINS=http://localhost:5173
